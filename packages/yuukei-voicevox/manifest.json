{
  "schemaVersion": 1,
  "id": "yuukei-voicevox",
  "displayName": "Yuukei VOICEVOX",
  "runtime": "process",
  "permissions": {
    "broadEventSubscription": false
  },
  "capabilities": [
    {
      "capability": "speech.synthesis",
      "methods": [
        "synthesize"
      ]
    }
  ],
  "process": {
    "command": "node",
    "args": [
      "src/main.mjs"
    ],
    "timeoutMs": 15000
  },
  "settings": {
    "fields": [
      {
        "key": "baseUrl",
        "type": "string",
        "label": "VOICEVOXとの接続先",
        "description": "通常は変更不要です。VOICEVOXを別の場所で動かしている場合だけ変更してください。",
        "default": "http://127.0.0.1:50021"
      },
      {
        "key": "speaker",
        "type": "number",
        "label": "標準で使う声の番号",
        "description": "VOICEVOXの話者一覧に表示される番号を入力します。",
        "default": 2,
        "min": 0
      },
      {
        "key": "speedScale",
        "type": "number",
        "label": "話す速さ",
        "description": "1が標準です。小さくするとゆっくり、大きくすると速く話します。",
        "default": 1,
        "min": 0.1,
        "max": 3
      },
      {
        "key": "speakerOverrides",
        "type": "string",
        "label": "住人ごとの声",
        "description": "住人の名前と声の番号を「yuukei=2,partner=3」のように入力します。",
        "default": "yuukei=2,partner=3"
      }
    ]
  }
}
